<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <!--
    A partir de aquí el histórico de cambios de esquema/datos se versiona con Liquibase.
    El resto de tablas las sigue gestionando Hibernate (spring.jpa.hibernate.ddl-auto: update)
    hasta que decidamos migrar también esa parte a changelogs explícitos.

    Nuevos cambios: añadir un fichero nuevo en db/changelog/changes/ e incluirlo aquí,
    nunca modificar un changeSet ya aplicado en algún entorno.
  -->
  <include file="db/changelog/changes/001-roles-table-and-seed.xml" relativeToChangelogFile="false"/>
  <include file="db/changelog/changes/002-usuario-pena.xml" relativeToChangelogFile="false"/>
  <include file="db/changelog/changes/003-evento-asistencia-penalizaciones.xml" relativeToChangelogFile="false"/>
  <include file="db/changelog/changes/004-pena-slug.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>

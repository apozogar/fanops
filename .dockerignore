# .git SÍ hace falta en el contexto de build: git-commit-id-maven-plugin lo lee para escribir
# el commit del build en git.properties (lo expone /management/info). Sin él, el propio COPY
# .git ./.git del Dockerfile falla porque Docker nunca recibe la carpeta.
.gitignore

# Ignorar la carpeta de compilación de Maven
target/

# Ignorar la carpeta de dependencias de Node.js que se genera dentro de frontend
frontend/node/
frontend/node_modules/

# Ignorar logs y archivos temporales
*.log
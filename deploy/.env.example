# Copiar a .env en el servidor y rellenar. NO se commitea: .env está en .gitignore.

# --- Dominio (sin https://) ---
DOMINIO=fanops.tudominio.com

# --- Base de datos ---
# Si Postgres corre en el propio servidor (fuera de Docker), el host es
# host.docker.internal. Si corre en otro contenedor, su nombre de servicio. Si es
# gestionado, su host real.
# Ojo: es una URL JDBC, no la cadena de psql: sin usuario ni contraseña dentro.
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/fanops
SPRING_DATASOURCE_USERNAME=fanops
SPRING_DATASOURCE_PASSWORD=

# 'update' en el primer arranque, para que Hibernate cree el esquema en una base de datos
# vacía. Cuando esté estable, pasar a 'validate'.
SPRING_JPA_DDL_AUTO=update

# --- Seguridad ---
# Generar con: openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
APP_JWT_SECRET=

# --- URL pública (enlaces de los correos y de WhatsApp) ---
PUBLIC_BASE_URL=https://fanops.tudominio.com

# --- Correo ---
# En un VPS los puertos SMTP no están bloqueados, así que se puede usar 'smtp' con las
# SMTP_* en lugar de la API de Resend.
APP_EMAIL_PROVEEDOR=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME=FanOps
MAIL_ACTIVE=true

# Solo si APP_EMAIL_PROVEEDOR=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Superadmin inicial (solo se crea si no existe ninguno) ---
APP_SUPERADMIN_EMAIL=
APP_SUPERADMIN_PASSWORD=

# --- WhatsApp (opcional) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Ajustes ---
LOG_LEVEL_APP=INFO
DB_POOL_MAX=5
DB_POOL_MIN=1
